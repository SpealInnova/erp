APP_ENV=desarrollo
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=
APP_URL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# El mismo GMAIL_REFRESH_TOKEN se usa para Drive (evidencias/archivos adjuntos).
# Debe estar autorizado con los scopes de Gmail Y de Drive (drive.file) a la vez.
DRIVE_FOLDER_ID=
# Copias de seguridad (estado completo de la base, .sql.gz en Drive).
# COPIAS_DIARIAS=1 activa la copia automática diaria (solo en producción);
# COPIAS_HORA es la hora desde la que se hace (0-23, por defecto 2).
# DRIVE_COPIAS_FOLDER_ID es la carpeta de las copias; si está vacía, se usa
# DRIVE_FOLDER_ID. Ver docs/COPIAS_DE_SEGURIDAD.md.
COPIAS_DIARIAS=
COPIAS_HORA=
DRIVE_COPIAS_FOLDER_ID=
