{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "error",
    "eqeqeq": "error",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["src/public/**/*.js"],
      "env": {
        "node": false,
        "browser": true
      }
    }
  ]
}
